# ==============================================================================
# UPI Fraud Detection & Risk Assessment System — Frontend Configuration
#
# STUDENT GUIDE FOR ENVIRONMENT VARIABLES:
# ------------------------------------------------------------------------------
# 1. In Vite applications, all environment variables MUST start with `VITE_`.
# 2. To configure your live database:
#    - Copy this file to `frontend/.env` (if not already present).
#    - Set `VITE_SUPABASE_URL` to your project URL from the Supabase Dashboard.
#    - Set `VITE_SUPABASE_ANON_KEY` to your Project Settings -> API -> anon public key.
# 3. Security:
#    - The anon key is safe for client-side use because PostgreSQL Row Level Security
#      (RLS) prevents unauthorized database access.
# ==============================================================================

# Supabase Project REST Endpoint
VITE_SUPABASE_URL=https://eojjgcmdxkavnqzkjkjr.supabase.co

# Supabase Anonymous / Publishable Key (Safe for frontend use)
VITE_SUPABASE_ANON_KEY=
